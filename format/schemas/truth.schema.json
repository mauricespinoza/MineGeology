{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geomapper.invalid/format/truth.schema.json",
  "title": "GeoMapper answer key (never sent to the student before grading)",
  "type": "object",
  "additionalProperties": false,
  "required": ["units", "column", "events", "map", "contacts", "fold_axes", "lumpable", "key_outcrops"],
  "properties": {
    "units": {
      "type": "array",
      "minItems": 1,
      "description": "Same keys and order as units.json.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "age"],
        "properties": {
          "key": { "$ref": "#/$defs/unitKey" },
          "name": { "type": "string", "minLength": 1 },
          "series": { "type": "string", "pattern": "^s[0-9]{2}$" },
          "age": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "from_ma", "to_ma"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "from_ma": { "type": "number", "minimum": 0 },
              "to_ma": { "type": "number", "minimum": 0 }
            }
          },
          "lab_age": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "value_ma", "error_ma"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "material": { "type": "string", "minLength": 1 },
              "value_ma": { "type": "number", "minimum": 0 },
              "error_ma": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "column": {
      "type": "array",
      "description": "Stratified units, oldest first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "base_contact"],
        "properties": {
          "unit": { "$ref": "#/$defs/unitKey" },
          "thickness_m": { "type": "number", "exclusiveMinimum": 0 },
          "base_contact": { "enum": ["depositional", "unconformity", "intrusive", "fault", "not_exposed"] }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "rank", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^e[0-9]{2}$" },
          "type": { "enum": ["deposition", "tilting", "folding", "faulting", "intrusion", "erosion", "metamorphism", "uplift"] },
          "rank": { "type": "integer", "minimum": 1, "description": "1 is oldest. Equal ranks mean the order cannot be resolved and either is accepted." },
          "label": { "type": "string", "minLength": 1 },
          "units": { "type": "array", "items": { "$ref": "#/$defs/unitKey" } },
          "structures": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "map": {
      "type": "object",
      "description": "True bedrock map: unit index per surface cell, row-major with the southern row first, as [unit_index, run_length] runs.",
      "additionalProperties": false,
      "required": ["encoding", "runs"],
      "properties": {
        "encoding": { "const": "rle" },
        "runs": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "integer", "minimum": 0, "maximum": 254 }, { "type": "integer", "minimum": 1 }],
            "items": false,
            "minItems": 2
          }
        }
      }
    },
    "contacts": {
      "type": "object",
      "description": "GeoJSON FeatureCollection of contact and fault traces in local easting/northing.",
      "additionalProperties": false,
      "required": ["type", "features"],
      "properties": {
        "type": { "const": "FeatureCollection" },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "geometry", "properties"],
            "properties": {
              "type": { "const": "Feature" },
              "geometry": { "$ref": "#/$defs/lineString" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type"],
                "properties": {
                  "id": { "type": "string", "pattern": "^c[0-9]{2,4}$" },
                  "type": { "enum": ["depositional", "unconformity", "intrusive", "fault", "gradational"] },
                  "units": { "type": "array", "items": { "$ref": "#/$defs/unitKey" }, "minItems": 2, "maxItems": 2 },
                  "kinematics": { "enum": ["normal", "reverse", "thrust", "dextral", "sinistral", "oblique"] },
                  "strike": { "$ref": "#/$defs/azimuth" },
                  "dip": { "$ref": "#/$defs/inclination" }
                },
                "if": { "properties": { "type": { "const": "fault" } } },
                "then": { "required": ["kinematics"] },
                "else": { "required": ["units"] }
              }
            }
          }
        }
      }
    },
    "fold_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "trend", "plunge", "trace"],
        "properties": {
          "id": { "type": "string", "pattern": "^f[0-9]{2}$" },
          "type": { "enum": ["anticline", "syncline", "monocline"] },
          "trend": { "$ref": "#/$defs/azimuth" },
          "plunge": { "$ref": "#/$defs/inclination" },
          "trace": { "$ref": "#/$defs/lineString" }
        }
      }
    },
    "dykes": {
      "type": "array",
      "description": "Since 1.1.0. Sheet intrusions too thin for the lithology block; they are lines on the map, not map units.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "unit", "strike", "dip", "thickness_m", "trace"],
        "properties": {
          "id": { "type": "string", "pattern": "^d[0-9]{2}$" },
          "unit": { "$ref": "#/$defs/unitKey" },
          "strike": { "$ref": "#/$defs/azimuth" },
          "dip": { "$ref": "#/$defs/inclination" },
          "thickness_m": { "type": "number", "exclusiveMinimum": 0 },
          "trace": { "$ref": "#/$defs/lineString" }
        }
      }
    },
    "lumpable": {
      "type": "array",
      "description": "Groups of units the grader lets a student map as one.",
      "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/unitKey" } }
    },
    "key_outcrops": { "type": "array", "items": { "type": "string", "pattern": "^o[0-9]{3,5}$" } }
  },
  "$defs": {
    "unitKey": { "type": "string", "pattern": "^u[0-9]{2,3}$" },
    "azimuth": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
    "inclination": { "type": "number", "minimum": 0, "maximum": 90 },
    "lineString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "items": false, "minItems": 2 }
        }
      }
    }
  }
}
