{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geomapper.invalid/format/units.schema.json",
  "title": "GeoMapper unit descriptions (public: no formation names, no ages)",
  "type": "object",
  "additionalProperties": false,
  "required": ["units"],
  "properties": {
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "description": "Array position is the unit index stored in litho.bin and in the truth map raster.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "rock_class", "lithology", "colour", "texture", "resistance", "description"],
        "properties": {
          "key": { "type": "string", "pattern": "^u[0-9]{2,3}$", "description": "Opaque key; must not hint at stratigraphic order." },
          "rock_class": { "enum": ["sedimentary", "volcanic", "volcaniclastic", "plutonic", "hypabyssal", "metamorphic", "evaporite", "fault_rock"] },
          "lithology": { "type": "string", "minLength": 1 },
          "colour": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
          "texture": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "Block texture id used by the game." },
          "resistance": { "type": "number", "minimum": 0, "maximum": 1, "description": "Resistance to erosion; drives exposure and procedural relief." },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "hand_lens"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "hand_lens": { "type": "string", "minLength": 1 }
            }
          },
          "fossils": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "thin_section": { "type": "string", "minLength": 1, "description": "Lab description returned for a sample. Radiometric ages live in truth.json." },
          "photos": {
            "type": "array",
            "description": "Since 1.2.0. Reference photos of a similar rock, listed in the manifest's assets.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "credit", "licence"],
              "properties": {
                "kind": { "enum": ["hand_sample", "thin_section_ppl", "thin_section_xpl", "outcrop"] },
                "path": { "type": "string", "pattern": "^photos/[A-Za-z0-9_.-]+\\.jpg$" },
                "credit": { "type": "string", "minLength": 1 },
                "licence": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "pattern": "^https://" }
              }
            }
          }
        }
      }
    },
    "alterations": {
      "type": "array",
      "maxItems": 30,
      "description": "Since 1.6.0. Hydrothermal alteration zones that overprint the rock of the units, as seen in the field. Public: what the rock shows, never the zone's name (the answer key holds names, types and assays).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "colour", "minerals", "description"],
        "properties": {
          "key": { "type": "string", "pattern": "^a[0-9]{2}$", "description": "Opaque key; must not hint at the zoning order." },
          "colour": { "type": "string", "pattern": "^#[0-9a-f]{6}$", "description": "The tint the altered rock gives the ground." },
          "minerals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Alteration, gangue and ore minerals recognisable with the lens." },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "hand_lens"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "hand_lens": { "type": "string", "minLength": 1 }
            }
          },
          "features": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Veins, breccias or textures an outcrop of this zone may show." },
          "thin_section": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
